#!/usr/bin/env bash
#
# unit: a build's unit tests, each in a directory of its own.
#
#     test/unit dir
#
# dir holds a build's programs: a build's directory, which make all
# fills, or the folder CI's Windows runner downloads. Each test of the
# table below runs from the tree's root with its arguments, DIR among
# them standing for dir/run/NAME, made empty first: the EMU8000 against
# its documents (emu8ktest), the Classic's input and its bindings
# (inputtest), Alt+F4 and the Windows keys refused (syskeystest), the
# wide screen's width (widetest), the clock's retraces, pace and ticks
# (clocktest), the preferences' files and their writer (filestest), a
# CD's image read on images of the test's own (cdimagetest), the
# installs the port finds on test/trees (installtest), and for a Linux
# build sys/sdl.c's gamepad on SDL's virtual gamepad (padtest). cfgtest
# runs in test/nodata. A Windows build's tests (NAME.exe) run natively
# under Git Bash or MSYS2, and on Linux under tools/winerun, which
# starts this script again in its Wine prefix on the project's Xephyr.
# The paths given to a test are relative to the root, which a Windows
# test reads as they are, natively and under Wine.

set -Eeuo pipefail

TEST=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO=$(cd -- "$TEST/.." && pwd)

# a test a line, its name and its arguments
tests=(
	'emu8ktest'
	'inputtest DIR'
	'syskeystest'
	'widetest'
	'clocktest'
	'filestest DIR'
	'cdimagetest DIR'
	'installtest DIR test/trees'
)
# the tests of a Linux build alone
linuxtests=(
	'padtest -p DIR'
)

usage() {
	echo "usage: unit dir" >&2
	exit 2
}

(( $# == 1 )) || usage
[[ -d $1 ]] || { echo "unit: no $1" >&2; exit 1; }
dir=$(realpath --relative-to="$REPO" -- "$1")
cd -- "$REPO"

# a Windows build's programs end in .exe
exe=
for f in "$dir"/*.exe; do
	[[ -e $f ]] && exe=.exe
	break
done
if [[ -n $exe && $(uname -s) == Linux && -z ${WINERUN_CLEAN:-} ]]; then
	exec tools/winerun -q -e test/unit "$dir"
fi
if [[ -z $exe ]]; then
	tests+=("${linuxtests[@]}")
fi

for t in "${tests[@]}"; do
	read -r -a args <<<"$t"
	name=${args[0]}
	prog=$dir/$name$exe
	[[ -x $prog ]] || { echo "unit: no $prog (make test builds it)" >&2; exit 1; }
	run=$dir/run/$name
	rm -rf -- "$run"
	mkdir -p -- "$run"
	for i in "${!args[@]}"; do
		[[ ${args[i]} == DIR ]] && args[i]=$run
	done
	if [[ $name == padtest ]]; then
		SDL_VIDEO_DRIVER=dummy SDL_AUDIO_DRIVER=dummy "./$prog" "${args[@]:1}"
	else
		"./$prog" "${args[@]:1}"
	fi || { echo "unit: $name failed" >&2; exit 1; }
done
