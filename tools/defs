#!/usr/bin/env bash
#
# defs: each module's .def made again, the prototypes of the functions
# it defines, from gcc's -aux-info and tools/mkdefs.py.
#
#     tools/defs [-o dir] module...
#
# For each module of sources/, gcc -m32 writes into dir (build/defs by
# default) the declarations of the CD version (CDROM defined), of the
# disk version, of the DOS build with the fixes and of LBA.EXE's code
# (DOS defined, C89, Watcom's far and its critical error's answer made
# void). tools/mkdefs.py makes the .def from them: the CD version's
# declarations, those the disk version lacks outside DOS alone, those
# the DOS build declares otherwise under DOS, and those the fixes add or
# change under FIXES. A .def that changed takes the place of
# sources/MODULE.def. ccache is turned off, so that gcc runs and writes
# the -aux-info files.

set -Eeuo pipefail

TOOLS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO=$(cd -- "$TOOLS/.." && pwd)

usage() {
	echo "usage: defs [-o dir] module..." >&2
	exit 2
}

out=build/defs
while getopts o: c; do
	case $c in
	o) out=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
(( $# )) || usage
mkdir -p -- "$out"
out=$(cd -- "$out" && pwd)
cd -- "$REPO"

export CCACHE_DISABLE=1
cc=(gcc -m32 -funsigned-char -w -fsyntax-only -include sys/compat.h)
dos=(-std=gnu89 -D__far= -Dfar= -D_HARDERR_RETRY=0 -DCDROM=1 -DDOS)
for m; do
	"${cc[@]}" -std=c99 -aux-info "$out/$m.aux" -DCDROM=1 "sources/$m.c"
	"${cc[@]}" -std=c99 -aux-info "$out/$m.disk.aux" "sources/$m.c"
	"${cc[@]}" "${dos[@]}" -aux-info "$out/$m.dos.aux" -DFIXES "sources/$m.c"
	"${cc[@]}" "${dos[@]}" -aux-info "$out/$m.cd.aux" "sources/$m.c"
	python3 -I tools/mkdefs.py -u sys/compat.h -n "$out/$m.disk.aux" -d "$out/$m.dos.aux" \
		-c "$out/$m.cd.aux" "$out/$m.aux" "sources/$m.c" >"$out/$m.def"
	cmp -s "$out/$m.def" "sources/$m.def" || cp "$out/$m.def" "sources/$m.def"
done
