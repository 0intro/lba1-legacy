#!/usr/bin/env bash
#
# extract: the files of the game's discs where the tests and the oracles
# read them.
#
#     tools/extract [pc] [disc] [ps]
#
# pc is the PC CD, its data track little_big_adventure_1.iso in $LBAISO
# (../iso by default): its files go into $LBATMP/pc as the CD holds them,
# LBA.EXE into $LBATMP/elf/lba.elf as tools/le2elf.py makes it, its
# 6901 fixups checked, and each of the CD's drivers into
# $LBATMP/elf/dll, with the names and regions of its map in re/ where it
# has one (re/*.dll.sym).
# disc is the PC CD's whole image, the Internet Archive's item
# adeline_202401 in $LBAISO: ADELINE.BIN and its cue sheet go into
# $LBATMP/iso/adeline, where make check reads it as the CD. ps is the
# PlayStation's disc, SLES-00698, the Redump image in $LBAISO: the nine
# files of its root's data, its executable and SYSTEM.CNF, its texts
# (TEXT.HQR) and its scenes (GAME.HQR, SCENES.BLK) among them, go into
# $LBATMP/ps, where make check and test/lbapatch read the texts and the
# scenes and cdimagetest the whole root, and its cue sheet is linked as
# $LBATMP/iso/ps/ps.cue beside links to its BIN files, a name make
# passes whole. By default extract makes pc.

set -Eeuo pipefail

TOOLS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPO=$(cd -- "$TOOLS/.." && pwd)
TOP=$(cd -- "$REPO/.." && pwd)
LBATMP=${LBATMP:-$TOP/lba1-tmp}
ISO=${LBAISO:-$TOP/iso}
# absolute: the PlayStation's links take their targets from it
[[ -d $ISO ]] && ISO=$(cd -- "$ISO" && pwd)
PCISO=$ISO/little_big_adventure_1.iso
PSCUE="$ISO/Little Big Adventure (Europe) (En,Fr,De,Es,It).cue"
PSBIN="$ISO/Little Big Adventure (Europe) (En,Fr,De,Es,It) (Track 01).bin"
DISCZIP=$ISO/adeline_202401.zip

usage() {
	echo 'usage: extract [pc] [disc] [ps]' >&2
	exit 2
}

fail() {
	echo "extract: $*" >&2
	exit 1
}

pc() {
	local f b
	local -a map

	[[ -f $PCISO ]] || fail "no $PCISO"
	rm -rf -- "$LBATMP/pc.new"
	mkdir -p "$LBATMP/pc.new" "$LBATMP/elf/dll"
	bsdtar -xf "$PCISO" -C "$LBATMP/pc.new"
	chmod -R u+w "$LBATMP/pc.new"
	[[ -s $LBATMP/pc.new/LBA/LBA.EXE ]] || fail "$PCISO: no LBA/LBA.EXE"
	rm -rf -- "$LBATMP/pc"
	mv -- "$LBATMP/pc.new" "$LBATMP/pc"
	python3 -I "$TOOLS/le2elf.py" -v -f "$LBATMP/elf/lba.fix" -o "$LBATMP/elf/lba.elf" \
		"$LBATMP/pc/LBA/LBA.EXE" 2> "$LBATMP/elf/lba.txt"
	grep -q 'fixups 6901 02/00=3 07/00=5586 07/10=1312 split=5' "$LBATMP/elf/lba.txt" ||
		fail "LBA.EXE's fixups are not its 6901 (see $LBATMP/elf/lba.txt)"
	for f in "$LBATMP"/pc/LBA/*.DLL; do
		b=${f##*/}
		b=${b%.DLL}
		b=${b,,}
		map=()
		[[ -s $REPO/re/$b.dll.sym ]] && map=(-s "$REPO/re/$b.dll.sym")
		python3 -I "$TOOLS/le2elf.py" -x 1 "${map[@]}" -f "$LBATMP/elf/dll/$b.fix" \
			-o "$LBATMP/elf/dll/$b.elf" "$f"
	done
}

disc() {
	[[ -f $DISCZIP ]] || fail "no $DISCZIP"
	rm -rf -- "$LBATMP/iso/adeline.new"
	mkdir -p "$LBATMP/iso/adeline.new"
	unzip -q "$DISCZIP" ADELINE.BIN ADELINE.CUE -d "$LBATMP/iso/adeline.new"
	[[ -s $LBATMP/iso/adeline.new/ADELINE.CUE ]] || fail "$DISCZIP: no ADELINE.CUE"
	rm -rf -- "$LBATMP/iso/adeline"
	mv -- "$LBATMP/iso/adeline.new" "$LBATMP/iso/adeline"
}

ps() {
	local f

	[[ -f $PSBIN ]] || fail "no $PSBIN"
	[[ -f $PSCUE ]] || fail "no $PSCUE"
	rm -rf -- "$LBATMP/ps.new"
	mkdir -p "$LBATMP/ps.new"
	python3 -I "$TOOLS/isocat.py" -o "$LBATMP/ps.new" "$PSBIN" /SLES_006.98 /SYSTEM.CNF \
		/TEXT.HQR /GAME.HQR /SCENES.BLK /BUMPER.HQR /CREDITS.HQR /HOLOMAP.HQR /WARNING.BIN
	for f in SLES_006.98 SYSTEM.CNF TEXT.HQR GAME.HQR SCENES.BLK BUMPER.HQR CREDITS.HQR HOLOMAP.HQR WARNING.BIN; do
		[[ -s $LBATMP/ps.new/$f ]] || fail "$PSBIN: no $f"
	done
	rm -rf -- "$LBATMP/ps"
	mv -- "$LBATMP/ps.new" "$LBATMP/ps"
	rm -rf -- "$LBATMP/iso/ps"
	mkdir -p "$LBATMP/iso/ps"
	ln -s -- "$PSCUE" "$LBATMP/iso/ps/ps.cue"
	for f in "${PSCUE%.cue}"*.bin; do
		ln -s -- "$f" "$LBATMP/iso/ps/"
	done
}

(( $# )) || set -- pc
for d; do
	case $d in
	pc) pc ;;
	disc) disc ;;
	ps) ps ;;
	*) usage ;;
	esac
done
