# A32GFX.DLL (CD, 45056 bytes, CRC-32 5b8bf0fa): AIL/32's XMIDI driver
# for the Sound Blaster AWE32, one object at 0x10000 (0x9b09 bytes,
# CRC-32 1272e811 with its fixups applied there). Regions (X code, R
# read-only data, W variables) cut the object exactly. Then come the
# functions (T), data (D, sized) and unreachable blocks (U). The
# sequencer is xmidi32.asm, the glue AIL's yamaha32.inc skeleton for
# SBPRO2 around Creative's AWE32 library.
0x10000 R index 0x163
0x10163 W ddt 0x56
0x101b9 X glue 0x19f
0x10358 W seqdata 0x22b
0x10583 X seq 0x150f
0x11a92 X apiglue 0x48
0x11ada R midijump 0x1c
0x11af6 X midi 0xc0
0x11bb6 W ports 0x10
0x11bc6 W inits 0x400
0x11fc6 W voices 0x4fe
0x124c4 W eqlevels 0x2
0x124c6 R eqtab 0xc0
0x12586 X lib1 0xa68
0x12fee R ctrljump 0x200
0x131ee R tables 0x284
0x13472 W layers 0x250
0x136c2 R parsetab 0xb4
0x13776 W mods 0xf0
